// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String?
  createdAt    DateTime    @default(now())
  role         UserRole    @default(STAFF)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  weeks                  Week[]
  chatLogs               ChatbotAuditLog[]
  chatbotActionProposals ChatbotActionProposal[]

  @@index([departmentId])
  @@map("users")
}

enum UserRole {
  ADMIN
  ANALYST
  STAFF
}

// ChatbotAuditLog - One row per chatbot exchange, used for cost tracking and abuse review.
model ChatbotAuditLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  question     String   @db.Text
  generatedSql String?  @db.Text
  rowCount     Int?
  answer       String?  @db.Text
  totalTokens  Int?
  durationMs   Int?
  errorMessage String?  @db.Text
  contextPath  String?
  feedback     String?
  actionType   String?
  actionStatus String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("chatbot_audit_logs")
}

enum ChatbotActionStatus {
  PENDING
  EXECUTED
  EXPIRED
  REJECTED
}

// A write action prepared by AI. Payload is validated again at execution time.
// The row is user-bound and single-use, preventing replay/double submission.
model ChatbotActionProposal {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  actionType  String
  title       String
  description String              @db.Text
  payload     Json
  status      ChatbotActionStatus @default(PENDING)
  expiresAt   DateTime
  executedAt  DateTime?
  resultId    String?
  createdAt   DateTime            @default(now())

  @@index([userId, status, expiresAt])
  @@index([expiresAt])
  @@map("chatbot_action_proposals")
}

// Week model - represents a weekly report
model Week {
  id            String   @id @default(cuid())
  weekNumber    Int
  year          Int
  startDate     DateTime
  endDate       DateTime
  reportFileUrl String?
  status        Status   @default(DRAFT)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy        User               @relation(fields: [createdById], references: [id])
  tasks            Task[] // DEPRECATED
  taskProgress     WeekTaskProgress[] // NEW
  metricValues     WeekMetricValue[] // NEW - Số liệu định lượng
  extractedMetrics ExtractedMetric[]
  summary          WeeklySummary?

  @@unique([weekNumber, year])
  @@index([createdById])
  @@index([year, weekNumber])
  @@map("weeks")
}

// Department model - represents departments/phòng ban
model Department {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  masterTasks           MasterTask[]
  tasks                 Task[]
  metricDefinitions     MetricDefinition[]
  workItems             WorkItem[]
  crmInteractions       CrmInteraction[]
  taskThreads           TaskThread[]
  reportProfile         DepartmentReportProfile?
  secretaries           Secretary[]
  transfersFrom         SecretaryTransferLog[]   @relation("TransferFrom")
  transfersTo           SecretaryTransferLog[]   @relation("TransferTo")
  secretaryApplications SecretaryApplication[]   @relation("ApplicationDesiredDept")
  licenses              License[]
  mous                  MOU[]
  extractedMetrics      ExtractedMetric[]
  users                 User[]

  @@map("departments")
}

// MasterTask - Danh sách nhiệm vụ chung của mỗi phòng
model MasterTask {
  id                String          @id @default(cuid())
  departmentId      String
  name              String          @db.Text
  description       String?         @db.Text
  estimatedDuration Int? // Số tuần dự kiến hoàn thành (DEPRECATED - dùng startDate/endDate)
  progressType      ProgressType    @default(RECURRING)
  /// Con số tiến độ của nhiệm vụ này nghĩa là gì. Dashboard chỉ tính "tiến độ
  /// trung bình" trên các nhiệm vụ có COMPLETION.
  progressMeaning   ProgressMeaning @default(WEEKLY_DONE)
  startDate         DateTime? // Ngày bắt đầu nhiệm vụ
  endDate           DateTime? // Ngày kết thúc nhiệm vụ

  /// Nghiệp vụ cha. Ví dụ "Ghép gan" thuộc "Ghép tạng".
  parentId String?
  parent   MasterTask?  @relation("TaskTree", fields: [parentId], references: [id])
  children MasterTask[] @relation("TaskTree")

  /// Mọi cách viết khác của cùng nghiệp vụ này trong file Excel.
  /// Mỗi lần người duyệt xác nhận, cách viết đó được thêm vào đây — lần sau
  /// khớp ngay không cần gọi AI. Đây là cơ chế học dần của pipeline.
  aliases String[] @default([])

  /// MANUAL (người tạo) | AI_GROUPED (AI gom từ dữ liệu cũ) | AI_SUGGESTED (chờ duyệt)
  sourceType    String  @default("MANUAL")
  firstSeenWeek Int? /// Tuần đầu xuất hiện, phục vụ phân loại
  lastSeenWeek  Int?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department       Department         @relation(fields: [departmentId], references: [id])
  weekProgress     WeekTaskProgress[]
  extractedMetrics ExtractedMetric[]

  @@index([departmentId])
  @@index([createdAt])
  @@index([parentId])
  @@map("master_tasks")
}

// WeekTaskProgress - Tiến độ nhiệm vụ từng tuần
model WeekTaskProgress {
  id           String    @id @default(cuid())
  masterTaskId String
  weekId       String
  orderNumber  Int // Thứ tự hiển thị trong tuần
  result       String    @db.Text // Kết quả tuần này
  timePeriod   String // Thời gian thực hiện
  progress     Int? // 0-100, null nếu nhiệm vụ không có tiến độ
  nextWeekPlan String    @db.Text
  isImportant  Boolean   @default(false)
  completedAt  DateTime? // Ngày hoàn thành (nếu progress = 100)

  /// Đối tượng cụ thể của tuần này. Nhiệm vụ là "Vận hành hệ thống phần mềm",
  /// subject là "Phần mềm Chỉ định CLS" — gom về một nghiệp vụ mà không mất chi tiết.
  subject       String? @db.Text
  /// Tên nhiệm vụ y như trong file Excel, giữ để đối chiếu khi nghi ngờ khớp sai.
  rawTaskName   String? @db.Text
  /// Ô "Kết quả thực hiện" gốc, trước khi AI xử lý.
  rawResultText String? @db.Text

  extractionModel String? /// Model đã trích (glm-4.5…), để so sánh chất lượng
  matchConfidence Float? /// Độ tin cậy khớp MasterTask, 0-1
  matchReasoning  String?  @db.Text /// AI giải thích vì sao khớp, giúp người duyệt nhanh
  /// Cờ cần rà soát: LOW_CONFIDENCE, METRIC_ANOMALY, PROGRESS_REGRESSION…
  reviewFlags     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterTask MasterTask @relation(fields: [masterTaskId], references: [id], onDelete: Cascade)
  week       Week       @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([masterTaskId, weekId]) // Mỗi nhiệm vụ chỉ xuất hiện 1 lần/tuần
  @@index([weekId])
  @@index([masterTaskId])
  @@index([weekId, masterTaskId])
  @@map("week_task_progress")
}

// Task model - DEPRECATED - giữ lại để backward compatible
// Sẽ migrate dần sang WeekTaskProgress
model Task {
  id           String   @id @default(cuid())
  weekId       String
  departmentId String
  orderNumber  Int
  taskName     String   @db.Text
  result       String   @db.Text
  timePeriod   String
  progress     Int? // 0-100, null nếu nhiệm vụ không có tiến độ
  nextWeekPlan String   @db.Text
  isImportant  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  week       Week       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@index([weekId])
  @@index([departmentId])
  @@map("tasks")
}

// MetricDefinition - Định nghĩa các chỉ số của phòng ban
model MetricDefinition {
  id           String   @id @default(cuid())
  departmentId String
  name         String   @db.Text // Tên chỉ số (VD: "Số ca ghép tim", "Nghiên cứu khoa học")
  unit         String? // Đơn vị (VD: "ca", "bài", "nghiên cứu")
  description  String?  @db.Text
  orderNumber  Int      @default(0) // Thứ tự hiển thị
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  weekValues WeekMetricValue[]

  @@index([departmentId])
  @@map("metric_definitions")
}

// WeekMetricValue - Giá trị số liệu theo tuần
model WeekMetricValue {
  id        String   @id @default(cuid())
  metricId  String
  weekId    String
  value     Float // Giá trị số liệu
  note      String?  @db.Text // Ghi chú (nếu có)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metric MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)
  week   Week             @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([metricId, weekId]) // Mỗi chỉ số chỉ có 1 giá trị/tuần
  @@index([weekId])
  @@index([metricId])
  @@index([weekId, metricId])
  @@map("week_metric_values")
}

// Event - Lịch làm việc
model Event {
  id           String      @id @default(cuid())
  date         DateTime // Ngày diễn ra
  time         String? // Giờ diễn ra (VD: "13g30", "08g00")
  location     String?     @db.Text // Địa điểm
  content      String      @db.Text // Nội dung sự kiện
  chair        String?     @db.Text // Người chủ trì
  participants String?     @db.Text // Đơn vị chuẩn bị/tham dự
  note         String?     @db.Text // Ghi chú
  status       EventStatus @default(UNCONFIRMED) // Trạng thái xác nhận
  isEdited     Boolean     @default(false) // Đã chỉnh sửa sau khi tạo
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([date])
  @@index([date, status])
  @@map("events")
}

enum Status {
  DRAFT
  COMPLETED
}

enum EventStatus {
  CONFIRMED // Đã xác nhận
  UNCONFIRMED // Chưa xác nhận
}

// Meeting Room - Phòng họp
model MeetingRoom {
  id          String  @id @default(cuid())
  name        String  @unique
  location    String? @db.Text
  capacity    Int
  description String? @db.Text

  // Thiết bị âm thanh
  hasMicrophone   Boolean @default(false)
  hasSpeaker      Boolean @default(false)
  audioSystemType String? @db.Text

  // Thiết bị hình ảnh
  hasProjector    Boolean @default(false)
  hasScreen       Boolean @default(false)
  hasTV           Boolean @default(false)
  hasSmartBoard   Boolean @default(false)
  visualEquipment String? @db.Text

  // Tiện ích khác
  hasWifi        Boolean @default(false)
  hasAircon      Boolean @default(false)
  hasWhiteboard  Boolean @default(false)
  furnitureType  String? @db.Text
  otherAmenities String? @db.Text

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  hospitalEvents HospitalEvent[]

  @@map("meeting_rooms")
}

// Hospital Event - Sự kiện bệnh viện
model HospitalEvent {
  id          String   @id @default(cuid())
  name        String   @db.Text
  date        DateTime
  time        String?
  description String?  @db.Text

  meetingRoomId String?
  meetingRoom   MeetingRoom? @relation(fields: [meetingRoomId], references: [id])

  eventType HospitalEventType @default(ORGANIZED)

  chair        String? @db.Text
  participants String? @db.Text
  note         String? @db.Text

  status   EventStatus @default(UNCONFIRMED)
  isEdited Boolean     @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  checklistItems EventChecklistItem[]

  @@index([date])
  @@index([meetingRoomId])
  @@index([date, meetingRoomId])
  @@index([deletedAt, date])
  @@map("hospital_events")
}

// Checklist Template - Master checklist
model ChecklistTemplate {
  id          String   @id @default(cuid())
  title       String   @db.Text
  description String?  @db.Text
  orderNumber Int      @default(0)
  isDefault   Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("checklist_templates")
}

// Event Checklist Item - Instance per event
model EventChecklistItem {
  id              String        @id @default(cuid())
  hospitalEventId String
  hospitalEvent   HospitalEvent @relation(fields: [hospitalEventId], references: [id], onDelete: Cascade)

  title       String    @db.Text
  description String?   @db.Text
  orderNumber Int       @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalEventId])
  @@map("event_checklist_items")
}

enum HospitalEventType {
  ORGANIZED // Tổ chức
  COLLABORATED // Phối hợp
}

// ==================== SECRETARY MANAGEMENT ====================

// SecretaryType - Loại thư ký
model SecretaryType {
  id          String   @id @default(cuid())
  name        String   @unique // VD: "Thư ký y khoa", "Thư ký hành chính"
  description String?  @db.Text
  color       String? // Màu hiển thị (hex code)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  secretaries  Secretary[]
  applications SecretaryApplication[]

  @@map("secretary_types")
}

// Secretary - Thư ký
model Secretary {
  id           String    @id @default(cuid())
  employeeCode String?   @unique // Mã nhân viên (VD: J15-120)
  fullName     String // Họ và tên
  dateOfBirth  DateTime? // Ngày sinh
  phone        String?
  email        String?
  avatar       String? // URL ảnh đại diện

  secretaryTypeId String?
  secretaryType   SecretaryType? @relation(fields: [secretaryTypeId], references: [id])

  currentDepartmentId String?
  currentDepartment   Department? @relation(fields: [currentDepartmentId], references: [id])

  status    SecretaryStatus @default(ACTIVE)
  startDate DateTime? // Ngày bắt đầu làm thư ký
  notes     String?         @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  certificates      SecretaryCertificate[]
  transferLogs      SecretaryTransferLog[]
  application       SecretaryApplication?
  examScores        SecretaryExamScore[]
  birthdayEmailLogs BirthdayEmailLog[]

  @@index([secretaryTypeId])
  @@index([currentDepartmentId])
  @@index([dateOfBirth])
  @@index([deletedAt, status, secretaryTypeId])
  @@map("secretaries")
}

model BirthdayEmailLog {
  id           String    @id @default(cuid())
  secretaryId  String
  secretary    Secretary @relation(fields: [secretaryId], references: [id], onDelete: Cascade)
  birthdayYear Int
  recipient    String
  status       String
  errorMessage String?   @db.Text
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@unique([secretaryId, birthdayYear])
  @@index([birthdayYear, status])
  @@map("birthday_email_logs")
}

// SecretaryExamScore - Điểm các kỳ thi nghiệp vụ
model SecretaryExamScore {
  id          String    @id @default(cuid())
  secretaryId String
  secretary   Secretary @relation(fields: [secretaryId], references: [id], onDelete: Cascade)

  examName String // VD: "Kỳ thi Nghiệp vụ Thư ký 2026"
  examYear Int
  part1    Float? // P1
  part2    Float? // P2
  part3    Float? // P3
  total    Float? // Tổng điểm
  rank     Int? // Hạng trong kỳ thi
  formula  String? // Công thức tính (ghi chú)
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([secretaryId, examName])
  @@index([secretaryId])
  @@index([examYear])
  @@map("secretary_exam_scores")
}

// SecretaryCertificate - Bằng cấp của thư ký
model SecretaryCertificate {
  id          String    @id @default(cuid())
  secretaryId String
  secretary   Secretary @relation(fields: [secretaryId], references: [id], onDelete: Cascade)

  name          String // Tên bằng cấp
  issuedYear    Int? // Năm cấp bằng
  issuedBy      String? // Nơi cấp
  attachmentUrl String? // File đính kèm (scan bằng)
  notes         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([secretaryId])
  @@map("secretary_certificates")
}

// SecretaryTransferLog - Lịch sử luân chuyển
model SecretaryTransferLog {
  id          String    @id @default(cuid())
  secretaryId String
  secretary   Secretary @relation(fields: [secretaryId], references: [id], onDelete: Cascade)

  fromDepartmentId String?
  fromDepartment   Department? @relation("TransferFrom", fields: [fromDepartmentId], references: [id])

  toDepartmentId String
  toDepartment   Department @relation("TransferTo", fields: [toDepartmentId], references: [id])

  transferDate   DateTime // Ngày luân chuyển
  decisionNumber String? // Số quyết định
  reason         String?  @db.Text // Lý do luân chuyển
  notes          String?  @db.Text

  createdAt DateTime @default(now())
  createdBy String? // User ID tạo record

  @@index([secretaryId])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
  @@index([transferDate])
  @@map("secretary_transfer_logs")
}

enum SecretaryStatus {
  ACTIVE // Đang hoạt động
  INACTIVE // Nghỉ việc
  ON_LEAVE // Đang nghỉ phép dài hạn
}

enum ApplicationStatus {
  SCREENING // Vòng 1 - Sơ tuyển
  INTERVIEW // Vòng 2 - Phỏng vấn
  ACCEPTED // Đã nhận việc
  REJECTED // Từ chối
}

enum ScreeningResult {
  PASS // Đạt
  FAIL // Không đạt
}

// ─────────────────────────────────────────────────────────────────────────────
// Vehicle (Lý lịch xe ô tô) — kept separate from the existing License table so
// the License rows remain about VEHICLE registrations / 'cavet' documents,
// while Vehicle here owns the per-vehicle lifetime maintenance log.
// ─────────────────────────────────────────────────────────────────────────────

enum VehicleCategory {
  AMBULANCE // Xe cứu thương
  ADMIN_CAR // Xe ô tô hành chính / con
  BUS // Xe khách
  TRUCK // Xe tải
  PICKUP // Xe pickup
  OTHER
}

enum VehicleStatus {
  IN_USE // Đang sử dụng
  RETIRED // Đã ngừng hoạt động
  SOLD // Đã thanh lý
  TRANSFERRED // Đã chuyển giao
}

model Vehicle {
  id                     String          @id @default(cuid())
  licensePlate           String          @unique // Biển số hiển thị (VD: 50A-007-20)
  licensePlateNormalized String          @unique // Chỉ chữ/số, viết hoa (VD: 50A00720)
  brand                  String? // Nhãn hiệu (TOYOTA, HYUNDAI, ...)
  model                  String? // Số loại (HIACE, FORTUNER, ...)
  category               VehicleCategory @default(OTHER)
  color                  String? // Màu sơn
  engineNumber           String? // Số máy
  chassisNumber          String? // Số khung
  seatCount              String? // Số chỗ (giữ raw vì format không thống nhất: "07 ngồi + 1 nằm", "05 chỗ"...)
  payloadKg              String? // Tải trọng hàng hóa
  curbWeightKg           String? // Tự trọng
  totalWeightKg          String? // Trọng lượng toàn bộ
  manufactureYear        Int? // Năm sản xuất
  manufactureCountry     String? // Nước sản xuất
  expiryYear             String? // Niên hạn sử dụng (có thể là "Không thời hạn")

  // Hồ sơ đăng ký
  registrationNumber    String? // Giấy đăng ký số
  registrationDate      DateTime? // Ngày cấp giấy đăng ký
  firstRegistrationDate DateTime? // Đăng ký lần đầu

  // Hồ sơ kiểm định
  inspectionCertNumber String? // Giấy chứng nhận kiểm định số
  inspectionExpiry     DateTime? // Kiểm định hết hạn
  insuranceExpiry      DateTime? // Bảo hiểm hết hạn

  // Chủ xe
  ownerName    String? // Tên chủ xe
  ownerAddress String? // Địa chỉ chủ xe
  manager      String? // Người quản lý phương tiện

  // Thông số kỹ thuật
  dimensions        String? // Kích thước bao (Dài×Rộng×Cao)
  tireSpecification String? // Sai vỏ
  wheelTrack        String? // Vết bánh trước/sau
  wheelbase         String? // Chiều dài cơ sở
  fuelType          String? // Nhiên liệu
  engineType        String? // Kiểu động cơ
  displacement      String? // Dung tích
  maxPower          String? // Công suất lớn nhất
  steeringSystem    String? // Hệ thống lái
  transmission      String? // Hộp số
  brakeSystem       String? // Phanh chính
  parkingBrake      String? // Phanh đỗ
  airConditioning   String? // Điều hòa

  // Vận hành
  status     VehicleStatus @default(IN_USE)
  rawHistory String?       @db.Text // Toàn bộ lịch sử bảo dưỡng raw từ file .doc
  sourceFile String? // Tên file gốc

  // Liên kết tới License (chứng nhận đăng ký) nếu có
  /// Giấy tờ của xe: cà-vẹt, giấy phép đèn còi ưu tiên, đăng kiểm…
  licenses License[]

  maintenanceLogs VehicleMaintenance[]
  /// File hồ sơ gốc (ảnh chụp đăng ký, đăng kiểm, bảo hiểm, PDF…).
  documents       VehicleDocument[]
  /// Chuyến đi của xe này, nối từ dữ liệu tổ xe qua biển số đã chuẩn hoá.
  trips           FleetTrip[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([status])
  @@index([brand])
  @@map("vehicles")
}

/// File hồ sơ gốc của xe, lưu thẳng trong Postgres.
///
/// App chạy trên Railway không có ổ đĩa bền vững (ghi vào public/uploads thì
/// mất sau mỗi lần deploy), còn hồ sơ xe chỉ vài chục MB — lưu trong DB là gọn
/// nhất và được sao lưu cùng dữ liệu. Muốn chuyển sang S3 chỉ cần đổi cột data
/// thành đường dẫn.
model VehicleDocument {
  id         String   @id @default(cuid())
  vehicleId  String
  title      String
  fileName   String
  mimeType   String
  size       Int
  /// SHA-256 nội dung — chống tải trùng cùng một file cho một xe.
  sha256     String
  data       Bytes
  uploadedBy String?
  createdAt  DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, sha256])
  @@index([vehicleId])
  @@map("vehicle_documents")
}

// VehicleMaintenance - 1 record bảo dưỡng / sửa chữa / sự kiện
model VehicleMaintenance {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  date           DateTime? // Ngày thực hiện (có thể null khi text không rõ)
  odometer       Int? // Số km (cây số)
  /// Kết quả kiểm tra số km so với lần bảo dưỡng trước cùng xe:
  /// OK | DECREASED | BIG_JUMP | NO_PREVIOUS
  ///
  /// Lý lịch gốc có lỗi đánh máy thật: "170.00km" thiếu một số 0 nên đọc ra
  /// 17.000 giữa chuỗi đang ở 165.000. Đánh dấu để người xem biết chỗ nào cần
  /// đối chiếu lại với bản gốc, thay vì lặng lẽ để số sai nằm trong thống kê.
  odometerStatus String    @default("OK")
  category       String? // Loại: BAO_DUONG / SUA_CHUA / DANG_KIEM / BAO_HIEM / KHAC
  description    String    @db.Text // Mô tả chi tiết
  workshop       String? // Gara/đơn vị thực hiện
  costAmount     Decimal?  @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, date])
  @@index([date])
  @@map("vehicle_maintenance_logs")
}

enum ScreeningRating {
  EXCELLENT // Xuất sắc
  GOOD // Tốt
  FAIR // Khá
  AVERAGE // Trung bình
  POOR // Kém
}

// SecretaryApplication - Hồ sơ ứng tuyển thư ký
model SecretaryApplication {
  id               String    @id @default(cuid())
  fullName         String
  dateOfBirth      DateTime?
  birthPlace       String? // Nơi sinh
  phone            String?
  email            String?
  permanentAddress String?   @db.Text // Địa chỉ thường trú
  temporaryAddress String?   @db.Text // Địa chỉ tạm trú
  cvUrl            String? // Link/URL CV đính kèm

  // Trình độ học vấn
  education            String? // Trình độ chuyên môn (VD: Cao đẳng Quản trị văn phòng)
  educationInstitution String? // Nơi đào tạo
  graduationYear       Int? // Năm tốt nghiệp
  graduationRank       String? // Xếp loại tốt nghiệp (Xuất sắc/Giỏi/Khá/...)

  // Chứng chỉ
  trainingCertificate String? @db.Text // Chứng chỉ đào tạo (VD: Thư ký y khoa năm 2022 tại UMP, Xếp loại: Xuất sắc)
  foreignLanguage     String? // Trình độ ngoại ngữ (VD: IELTS 6.0, TOEIC 485)
  itSkill             String? @db.Text // Trình độ tin học

  // Kinh nghiệm
  appliedPosition String? // Vị trí tuyển dụng (VD: Thư ký y khoa)
  workExperience  String?  @db.Text // Kinh nghiệm làm việc
  previousSalary  Decimal? @db.Decimal(15, 2) // Mức thu nhập đã được nhận
  resignReason    String?  @db.Text // Lý do nghỉ việc

  // Hiểu biết về Bệnh viện
  knowsHospital    Boolean? // Có hiểu biết về Bệnh viện?
  hospitalRelative String?  @db.Text // Thân nhân đang công tác tại Bệnh viện

  appliedTypeId String? // Loại thư ký ứng tuyển
  appliedType   SecretaryType? @relation(fields: [appliedTypeId], references: [id])

  desiredDepartmentId String? // Phòng ban mong muốn
  desiredDepartment   Department? @relation("ApplicationDesiredDept", fields: [desiredDepartmentId], references: [id])

  source String? // Nguồn tuyển dụng (LinkedIn, giới thiệu nội bộ, website...)

  status ApplicationStatus @default(SCREENING)

  // Vòng sơ tuyển
  screeningDate     DateTime? // Ngày sơ tuyển
  screeningLocation String? // Địa điểm sơ tuyển
  screeningPanel    String?   @db.Text // Thành phần tham gia sơ tuyển

  // Đánh giá chi tiết sơ tuyển (Xuất sắc/Tốt/Khá/Trung bình/Kém)
  ratingAppearance    ScreeningRating? // Tác phong, ngoại hình, trang phục
  ratingExpertise     ScreeningRating? // Nghiệp vụ chuyên môn
  ratingCommunication ScreeningRating? // Kỹ năng giao tiếp
  ratingITSkill       ScreeningRating? // Kỹ năng vi tính, tin học văn phòng
  ratingAI            ScreeningRating? // Khả năng ứng dụng AI trong công việc
  ratingKnowledge     ScreeningRating? // Mức độ am hiểu nhiều mảng kiến thức

  // Điểm bài thi (kỹ năng tin học)
  scoreMultipleChoice  Float? // Trắc nghiệm lý thuyết (/10)
  scoreWordProcessing  Float? // Soạn thảo văn bản (/10)
  scoreTypingSpeed     Float? // Tốc độ đánh máy (/10)
  typingWordsPerMinute Int? // Số từ/phút

  screeningResult ScreeningResult? // Kết luận: Đạt / Không Đạt
  screeningNotes  String?          @db.Text

  // Vòng phỏng vấn
  interviewDate  DateTime?
  interviewScore Float?
  interviewNotes String?   @db.Text

  notes String? @db.Text

  // Khi được nhận việc → liên kết với Secretary được tạo
  convertedSecretaryId String?    @unique
  convertedSecretary   Secretary? @relation(fields: [convertedSecretaryId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([appliedTypeId])
  @@index([desiredDepartmentId])
  @@index([screeningDate])
  @@map("secretary_applications")
}

// ==================== LICENSE / PERMIT MANAGEMENT ====================

enum LicenseCategory {
  HOSPITAL // Giấy phép hoạt động bệnh viện
  DEPARTMENT // Giấy phép khoa/đơn vị
  VEHICLE // Giấy phép xe cứu thương
  ADMIN_VEHICLE // Giấy phép xe hành chính
  EQUIPMENT // Giấy phép trang thiết bị y tế
  OTHER // Loại khác
}

// License - Giấy phép / chứng chỉ
model License {
  id            String          @id @default(cuid())
  name          String          @db.Text
  licenseNumber String?
  category      LicenseCategory
  issuedBy      String?         @db.Text
  issuedDate    DateTime?
  expiryDate    DateTime?
  scope         String?         @db.Text
  fileUrl       String?
  notes         String?         @db.Text

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Xe mà giấy tờ này thuộc về. Một xe có nhiều giấy tờ: cà-vẹt, giấy đèn
  /// còi ưu tiên, đăng kiểm — nên đây là quan hệ một-nhiều, không phải một-một.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  renewals LicenseRenewal[]

  @@index([category])
  @@index([departmentId])
  @@index([expiryDate])
  @@index([category, expiryDate])
  @@index([vehicleId])
  @@map("licenses")
}

// LicenseRenewal - Lịch sử gia hạn giấy phép
model LicenseRenewal {
  id        String  @id @default(cuid())
  licenseId String
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  renewedDate    DateTime
  newExpiryDate  DateTime?
  previousExpiry DateTime?
  renewedBy      String?
  decisionNumber String?
  fileUrl        String?
  notes          String?   @db.Text

  createdAt DateTime @default(now())

  @@index([licenseId])
  @@index([renewedDate])
  @@map("license_renewals")
}

// ==================== MOU MANAGEMENT ====================

enum MOUStatus {
  DRAFT // Đang soạn thảo
  ACTIVE // Đang hiệu lực
  EXPIRING // Sắp hết hạn
  EXPIRED // Đã hết hạn
  TERMINATED // Đã chấm dứt
}

enum MOUCategory {
  DOMESTIC // Hợp tác trong nước
  INTERNATIONAL // Hợp tác quốc tế
  ACADEMIC // Đào tạo - Nghiên cứu
  CLINICAL // Lâm sàng - Chuyên môn
  TECHNOLOGY // Công nghệ - Chuyển giao
  OTHER // Khác
}

// MOU - Biên bản ghi nhớ / Thỏa thuận hợp tác
model MOU {
  id        String      @id @default(cuid())
  title     String      @db.Text // Tên MOU
  mouNumber String? // Số hiệu MOU
  category  MOUCategory
  status    MOUStatus   @default(DRAFT)

  // Đối tác
  partnerName    String  @db.Text // Tên đối tác
  partnerCountry String? // Quốc gia đối tác
  partnerContact String? @db.Text // Thông tin liên hệ đối tác
  partnerLogo    String? // URL logo đối tác

  // Thời hạn
  signedDate    DateTime? // Ngày ký kết
  effectiveDate DateTime? // Ngày có hiệu lực
  expiryDate    DateTime? // Ngày hết hạn
  autoRenew     Boolean   @default(false) // Tự động gia hạn

  // Nội dung
  purpose  String? @db.Text // Mục đích hợp tác
  scope    String? @db.Text // Phạm vi hợp tác
  keyTerms String? @db.Text // Điều khoản chính (tóm tắt)
  fileUrl  String? // File MOU đính kèm
  notes    String? @db.Text

  // Phòng đầu mối
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Người phụ trách
  contactPerson String? // Người phụ trách phía BV
  contactEmail  String?
  contactPhone  String?

  // Nguồn office.umc.edu.vn (dự án "Theo dõi ký kết hợp tác toàn viện") — cào lại ghi đè các trường này
  externalCode     String? @unique // Mã công việc trên office (taskID)
  externalUrl      String?
  externalStatus   String? // Trạng thái gốc: Mới / Đang xử lý / Hoàn thành
  cooperationField String? // Lĩnh vực hợp tác gốc (FN264)
  progressPercent  Int? // % tiến độ ghi trên office
  watchers         String? @db.Text // Người theo dõi

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clauses      MOUClause[]
  progressLogs MOUProgress[]
  activities   MOUActivity[]
  documents    MOUDocument[]

  @@index([category])
  @@index([status])
  @@index([departmentId])
  @@index([expiryDate])
  @@index([status, expiryDate])
  @@map("mous")
}

enum ClauseStatus {
  NOT_STARTED // Chưa triển khai
  IN_PROGRESS // Đang triển khai
  COMPLETED // Hoàn thành
  ON_HOLD // Tạm dừng
  CANCELLED // Đã hủy
}

/// Bản chất của nhiệm vụ — quyết định cách hiểu con số tiến độ.
/// Đo trên 411 nhiệm vụ thật của 33 tuần, xem docs/HOSPITAL-REPORT-PIPELINE.md
enum ProgressType {
  RECURRING /// Nghiệp vụ thường quy, tuần nào cũng làm (Tổng đài, Hỗ trợ máy in)
  CUMULATIVE /// Dự án có đích, tiến độ tích luỹ tới 100% — loại DUY NHẤT tiến độ có nghĩa
  MILESTONE /// Việc một lần có mốc hoàn thành (họp, tiếp đoàn, ban hành quyết định)
  MONITORING /// Theo dõi chỉ số, giá trị nằm ở metric chứ không phải tiến độ
  UNRELIABLE /// Con số cố định vô nghĩa (5,5,5 hoặc 90,90,90) — loại khỏi thống kê
}

/// Con số trong cột "Tiến độ (%)" thực chất nghĩa là gì.
/// Tách khỏi ProgressType vì đây là hai câu hỏi khác nhau: nhiệm vụ thuộc loại gì,
/// và con số người ta điền vào có tin được không.
enum ProgressMeaning {
  COMPLETION /// % hoàn thành thật của toàn bộ công việc
  WEEKLY_DONE /// "Đã xong phần việc của tuần này", không phải xong hẳn
  TIME_RATIO /// % thời gian đã trôi qua trong năm (2%, 4%, 6%...)
  MEANINGLESS /// Điền cho có, không phản ánh gì
}

enum ClauseType {
  TRAINING // Đào tạo
  RESEARCH // Nghiên cứu khoa học
  CLINICAL // Chuyên môn / Lâm sàng
  TECHNOLOGY_TRANSFER // Chuyển giao kỹ thuật / Công nghệ
  EXPERT_EXCHANGE // Trao đổi chuyên gia
  FACILITY // Cơ sở vật chất / Phòng khám
  EQUIPMENT // Thiết bị / Vật tư
  FINANCE // Tài chính / Tài trợ
  HR // Nhân sự / Tuyển dụng
  EVENT // Hội thảo / Sự kiện
  PUBLICATION // Xuất bản / Ấn phẩm
  OTHER // Khác
}

enum ResponsibleParty {
  UMC // Phía UMC
  PARTNER // Phía đối tác
  BOTH // Cả hai bên
}

// MOUClause - Điều khoản / Hạng mục chi tiết của MOU
model MOUClause {
  id    String @id @default(cuid())
  mouId String
  mou   MOU    @relation(fields: [mouId], references: [id], onDelete: Cascade)

  orderNumber      Int // Thứ tự điều khoản
  clauseType       ClauseType       @default(OTHER) // Lĩnh vực / Loại hạng mục
  title            String           @db.Text // Tiêu đề hạng mục
  content          String?          @db.Text // Nội dung chi tiết
  responsibleParty ResponsibleParty @default(BOTH) // Bên chịu trách nhiệm
  responsible      String? // Người/đơn vị cụ thể phụ trách
  deadline         DateTime? // Hạn thực hiện
  progress         Int              @default(0) // 0-100%
  clauseStatus     ClauseStatus     @default(NOT_STARTED) // Trạng thái triển khai
  isCompleted      Boolean          @default(false)
  completedAt      DateTime?

  // Kết quả & đánh giá
  result  String? @db.Text // Kết quả đạt được
  quality String? // Đánh giá chất lượng (tốt/đạt/chưa đạt)
  budget  String? // Ngân sách / chi phí
  notes   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clauseProgress ClauseProgress[]

  @@index([mouId])
  @@index([mouId, orderNumber])
  @@index([mouId, clauseType])
  @@map("mou_clauses")
}

// ClauseProgress - Nhật ký tiến độ của TỪNG điều khoản/hạng mục
model ClauseProgress {
  id       String    @id @default(cuid())
  clauseId String
  clause   MOUClause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  date           DateTime @default(now())
  content        String   @db.Text // Nội dung cập nhật
  achievement    String?  @db.Text // Kết quả đạt được
  issues         String?  @db.Text // Vấn đề phát sinh
  nextSteps      String?  @db.Text // Kế hoạch tiếp theo
  progressBefore Int? // Tiến độ trước cập nhật
  progressAfter  Int? // Tiến độ sau cập nhật
  updatedBy      String? // Người cập nhật

  createdAt DateTime @default(now())

  @@index([clauseId])
  @@index([date])
  @@map("clause_progress")
}

// MOUProgress - Nhật ký tiến độ chung của MOU
model MOUProgress {
  id    String @id @default(cuid())
  mouId String
  mou   MOU    @relation(fields: [mouId], references: [id], onDelete: Cascade)

  date        DateTime @default(now()) // Ngày cập nhật
  content     String   @db.Text // Nội dung cập nhật
  achievement String?  @db.Text // Kết quả đạt được
  issues      String?  @db.Text // Vấn đề phát sinh
  nextSteps   String?  @db.Text // Kế hoạch tiếp theo
  updatedBy   String? // Người cập nhật
  externalKey String?  @unique // Dòng "Theo dõi tiến độ" trên office — chống nạp trùng

  createdAt DateTime @default(now())

  @@index([mouId])
  @@index([date])
  @@map("mou_progress")
}

// Loại hoạt động MOU
enum ActivityStatus {
  PLANNED // Đã lên kế hoạch
  IN_PROGRESS // Đang thực hiện
  COMPLETED // Hoàn thành
  CANCELLED // Đã hủy
}

// MOUActivity - Hoạt động cụ thể trong khuôn khổ MOU
model MOUActivity {
  id    String @id @default(cuid())
  mouId String
  mou   MOU    @relation(fields: [mouId], references: [id], onDelete: Cascade)

  title        String         @db.Text // Tên hoạt động
  description  String?        @db.Text // Mô tả chi tiết
  activityType String? // Loại hoạt động (đào tạo, nghiên cứu, trao đổi, hội thảo...)
  status       ActivityStatus @default(PLANNED)

  startDate    DateTime? // Ngày bắt đầu
  endDate      DateTime? // Ngày kết thúc
  location     String? // Địa điểm
  participants String?   @db.Text // Người tham gia
  responsible  String? // Người phụ trách
  budget       String? // Ngân sách dự kiến

  result String? @db.Text // Kết quả thực hiện
  notes  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mouId])
  @@index([status])
  @@index([startDate])
  @@map("mou_activities")
}

// MOUDocument - Văn bản / tài liệu đính kèm MOU
model MOUDocument {
  id    String @id @default(cuid())
  mouId String
  mou   MOU    @relation(fields: [mouId], references: [id], onDelete: Cascade)

  title        String // Tên văn bản
  description  String? @db.Text // Mô tả
  documentType String? // Loại (hợp đồng, phụ lục, biên bản, công văn...)
  fileUrl      String? // URL file
  fileName     String? // Tên file gốc
  fileSize     Int? // Kích thước file (bytes)
  uploadedBy   String? // Người upload
  mimeType     String?
  originalSize Int? // Kích thước trước khi nén PDF
  sha256       String?
  data         Bytes? // Nội dung file lưu trong DB (null: chỉ có liên kết fileUrl)
  externalCode String? @unique // Mã file đính kèm trên office (attchFileID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mouId])
  @@index([documentType])
  @@map("mou_documents")
}

// ═══════════════════════════════════════════════════════════════════════
// INGESTION LAYER — đồng bộ dữ liệu tập trung
// Xem docs/INGESTION-REFACTOR.md
// ═══════════════════════════════════════════════════════════════════════

enum SyncSourceKind {
  ONEDRIVE_SHARE // File Excel trên OneDrive qua share link
  GOOGLE_SHEETS // Spreadsheet qua service account
  GITHUB_JSON // File JSON trong GitHub repo (cầu vượt tường lửa cho API nội bộ)
  HTTP_API // API nội bộ gọi trực tiếp (khi chạy trong mạng UMC)
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED // Nguồn không đổi (checksum trùng) nên bỏ qua
}

// SyncSource - Khai báo một nguồn dữ liệu. Slug làm id để cấu hình đọc được.
model SyncSource {
  id            String         @id // slug, vd "dept-report-onedrive"
  name          String
  kind          SyncSourceKind
  config        Json // URL/repo/path/year, tuỳ kind
  cronEnabled   Boolean        @default(true)
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastChecksum  String? // bỏ qua khi nguồn không đổi
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  runs           SyncRun[]
  pendingImports PendingAiImport[]

  @@map("sync_sources")
}

// SyncRun - Một lần chạy đồng bộ của một nguồn.
model SyncRun {
  id           String        @id @default(cuid())
  sourceId     String
  status       SyncRunStatus @default(RUNNING)
  trigger      String // "cron" | "manual" | "webhook"
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  rowsRead     Int           @default(0)
  rowsUpserted Int           @default(0)
  rowsSkipped  Int           @default(0)
  errorMessage String?       @db.Text

  source SyncSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  logs   SyncLog[]

  @@index([sourceId, startedAt])
  @@index([startedAt])
  @@map("sync_runs")
}

// SyncLog - Chi tiết diễn biến trong một lần chạy (cảnh báo dòng lỗi, dòng bỏ qua...).
model SyncLog {
  id        String   @id @default(cuid())
  runId     String
  level     String // "info" | "warn" | "error"
  message   String   @db.Text
  context   Json?
  createdAt DateTime @default(now())

  run SyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("sync_logs")
}

enum PendingImportStatus {
  PENDING
  APPROVED
  REJECTED
}

// PendingAiImport - Báo cáo bệnh viện chờ AI xử lý + người duyệt.
// Cron chỉ tải file và tách sheet; KHÔNG tự ghi vào Week/WeekTaskProgress.
model PendingAiImport {
  id         String              @id @default(cuid())
  sourceId   String
  year       Int
  week       Int
  sheetName  String
  rawText    String              @db.Text // nội dung sheet đã trích
  status     PendingImportStatus @default(PENDING)
  syncRunId  String?
  reviewedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  source SyncSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, year, week])
  @@index([status])
  @@map("pending_ai_imports")
}

// Dấu vân tay nội dung báo cáo của từng phòng mỗi tuần, ghi lúc nạp bằng AI.
// Sheet tuần mới được chép từ tuần trước rồi sửa dần; so hash để nạp lại đúng
// phòng có thay đổi thay vì đóng băng bản nạp đầu tiên.
model HospitalImportSnapshot {
  id           String   @id @default(cuid())
  year         Int
  week         Int
  departmentId String
  contentHash  String
  taskCount    Int
  importedAt   DateTime @default(now())

  @@unique([year, week, departmentId])
  @@map("hospital_import_snapshots")
}

// Danh mục chỉ số chuẩn — cây cha/con theo từng phòng.
//
// AI trích báo cáo tuần ra hàng nghìn tên (một chỉ số có tới 8 cách viết).
// Cây này là "bản đồ" chính thức: mỗi chỉ số một mã, một đơn vị, một cách cộng
// dồn; các cách viết khác nằm ở MetricAlias. Nạp từ prisma/metric-catalog/*.json
// (bản đã duyệt) bằng prisma/load-metric-catalog.ts.
model MetricNode {
  /// Mã phân cấp, vd "hc.switchboard.tong_so_cuoc_goi_den_benh_vien"
  code          String   @id
  departmentId  String
  parentCode    String?
  name          String
  /// GROUP: nhóm, không có số | METRIC: chỉ số có số
  kind          String
  unit          String?
  /// SUM: cộng theo kỳ | LAST: lấy cuối kỳ (số tồn) | AVG: trung bình (tỷ lệ)
  aggregation   String?
  /// Cộng các khoản rời trong cùng tuần thay vì lấy một số (vd từng khoản tài trợ).
  sumWithinWeek Boolean  @default(false)
  /// Nguồn chính thức từ báo cáo Excel của phòng (hc_metrics), nếu có.
  hcCategory    String?
  hcContent     String?
  /// EXCEL (từ file số liệu) | REPORT (từ báo cáo tuần, AI đề xuất, người duyệt)
  origin        String
  orderNumber   Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent   MetricNode?   @relation("MetricTree", fields: [parentCode], references: [code])
  children MetricNode[]  @relation("MetricTree")
  aliases  MetricAlias[]

  @@index([departmentId])
  @@index([parentCode])
  @@map("metric_nodes")
}

// Một cách viết tên chỉ số (như trong extracted_metrics) và nó thuộc chỉ số chuẩn nào.
model MetricAlias {
  id           String   @id @default(cuid())
  departmentId String
  aliasName    String
  /// Đơn vị AI ghi kèm, '' nếu không có — cùng tên khác đơn vị có thể khác nghĩa.
  unit         String   @default("")
  nodeCode     String?
  /// MAPPED: thuộc nodeCode | VALUE: tên dùng chung, phân giải từng tuần theo giá
  /// trị khớp Excel trong candidates | SPORADIC: con số rời, chưa đủ tuần để
  /// thành chỉ số | NOISE: không phải chỉ số theo dõi
  status       String
  candidates   String[] @default([])
  /// AI | HUMAN | RULE — ai quyết định cách gắn này
  decidedBy    String
  model        String?
  weeksSeen    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  node MetricNode? @relation(fields: [nodeCode], references: [code])

  @@unique([departmentId, aliasName, unit])
  @@index([nodeCode])
  @@map("metric_aliases")
}

// HcMetric - Số liệu tuần của báo cáo phòng, nạp từ OneDrive.
// Nguồn: sheet "Số liệu tuần (<năm>)" — xem docs/ONEDRIVE-DATA-ANALYSIS.md
model HcMetric {
  id        String   @id @default(cuid())
  category  String // "Danh mục"
  content   String   @db.Text // "Nội dung"
  year      Int
  week      Int
  month     Int? // đọc thẳng từ file, không thuộc khoá
  value     Float // "Số liệu"
  sourceId  String
  syncRunId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, content, year, week])
  @@index([year, week])
  @@index([category])
  @@map("hc_metrics")
}

// FleetTrip - Chuyến xe, nạp từ Google Sheets (mỗi sheet = 1 xe).
// Thay cho manual_fleet_sync.py vốn đẩy qua GitHub. Xem docs/INGESTION-REFACTOR.md mục 4.1
model FleetTrip {
  id                 String   @id @default(cuid())
  // Nguồn không có ID ổn định; hash các trường định danh làm khoá.
  sourceRowHash      String   @unique
  /// Biển số xe như tài xế nhập trên Google Sheets — KHÔNG phải id của bảng xe.
  /// Giữ nguyên chuỗi gốc để đối chiếu khi nghi ngờ.
  vehicleId          String
  /// Hồ sơ xe tương ứng, nối bằng biển số đã chuẩn hoá.
  ///
  /// Tùy chọn vì chuyến đi có thể về trước khi hồ sơ xe được lập — dữ liệu tài
  /// xế nhập hằng ngày, còn hồ sơ do người quản lý tạo. Không để khoá ngoại bắt
  /// buộc chặn việc nạp chuyến.
  vehicleRefId       String?
  vehicle            Vehicle? @relation(fields: [vehicleRefId], references: [id], onDelete: SetNull)
  driverName         String
  vehicleType        String // "Hành chính" | "Cứu thương"
  recordDate         DateTime
  startTime          String?
  endTime            String?
  durationHours      Float?
  durationConfidence String   @default("medium") // high|medium|low
  durationMethod     String   @default("normal") // normal|fixed_ampm|overnight|estimated_*
  durationSuspicious Boolean  @default(false) // tin cậy thấp hoặc > 16h
  /// Chỉ số công-tơ-mét sau khi kết thúc chuyến, đọc từ ô tài xế nhập.
  /// null khi không nhập hoặc nhập nội dung không phải số.
  odometer           Int?
  /// Kết quả kiểm tra tính hợp lý của odometer so với chuyến trước cùng xe:
  /// OK | DECREASED | BIG_JUMP | NO_PREVIOUS | UNPARSED
  odometerStatus     String   @default("OK")
  /// Chênh lệch so với chuyến trước cùng xe (km). null khi không so được.
  odometerDelta      Int?

  distanceKm        Float?
  distanceFixMethod String? // NONE|ODO_DELTA|ESTIMATED_FROM_HOURS|UNFIXABLE
  fuelLiters        Float?
  revenueVnd        Float?
  destination       String   @db.Text
  workCategory      String
  areaType          String
  tripDetails       String?  @db.Text
  sourceId          String
  syncRunId         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([recordDate])
  @@index([vehicleId, recordDate])
  @@index([driverName])
  @@index([odometerStatus])
  @@map("fleet_trips")
}

// ═══════════════════════════════════════════════════════════════════════
// TRÍCH XUẤT BẰNG AI — báo cáo tuần bệnh viện
// Xem docs/HOSPITAL-REPORT-PIPELINE.md
// ═══════════════════════════════════════════════════════════════════════

/// Kỳ của một số liệu trích từ văn bản.
enum MetricPeriod {
  WEEK /// Số liệu riêng tuần này ("65 văn bản")
  CUMULATIVE /// Luỹ kế từ đầu ("Tính đến ngày 18/4 đã có 09 ca")
  MONTH
  QUARTER
  YEAR
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED /// Người duyệt đã sửa giá trị trước khi chấp nhận
}

/// Số liệu định lượng trích từ ô "Kết quả thực hiện".
///
/// Không dùng MetricDefinition/WeekMetricValue sẵn có vì: tên chưa chuẩn hoá,
/// có độ tin cậy, cần đối chiếu văn bản gốc, và phải qua người duyệt. Sau khi
/// một metric ổn định tên qua nhiều tuần, có thể thăng cấp thành MetricDefinition.
model ExtractedMetric {
  id           String  @id @default(cuid())
  weekId       String
  departmentId String
  masterTaskId String?

  name     String       @db.Text /// "Hồ sơ bệnh án tiếp nhận"
  value    Float
  unit     String? /// "HSBA", "ca", "văn bản", "%"
  period   MetricPeriod @default(WEEK)
  asOfDate DateTime? /// Với CUMULATIVE: luỹ kế tính đến ngày nào

  /// Đoạn văn gốc sinh ra số này, để đối chiếu khi nghi ngờ.
  sourceText    String       @db.Text
  confidence    Float        @default(0)
  reviewStatus  ReviewStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  /// Giá trị AI trích ban đầu, giữ lại khi người duyệt sửa.
  originalValue Float?

  /// Dấu hiệu bất thường phát hiện khi trích: DATE_FRAGMENT, COMPARISON_VALUE,
  /// OUTLIER_HIGH, OUTLIER_LOW, MIXED_SCALE, DUPLICATE_PERIOD…
  ///
  /// Chỉ đánh dấu, không tự sửa giá trị — máy đoán sai một lần là hỏng cả
  /// chuỗi, mà người đọc câu gốc là biết ngay.
  reviewFlags     String[] @default([])
  /// Mã chỉ số chuẩn (metric_nodes.code) do AI chọn từ danh mục lúc trích.
  /// NULL: số liệu ngoài danh mục — khi đó gắn qua metric_aliases theo tên.
  metricCode      String?
  extractionModel String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  week       Week        @relation(fields: [weekId], references: [id], onDelete: Cascade)
  department Department  @relation(fields: [departmentId], references: [id])
  masterTask MasterTask? @relation(fields: [masterTaskId], references: [id])

  @@index([weekId, departmentId])
  @@index([name])
  @@index([metricCode])
  @@index([reviewStatus])
  @@map("extracted_metrics")
}

/// Một lần chạy trích xuất AI. Cần bảng này vì model và prompt sẽ đổi nhiều lần —
/// không có nó thì không biết phiên bản nào cho kết quả tốt hơn.
model AiExtractionRun {
  id           String  @id @default(cuid())
  stage        String /// GROUP_TASKS | CLASSIFY | MATCH | EXTRACT_METRICS | RECONCILE
  departmentId String?
  year         Int?
  week         Int?

  model         String /// "glm-4.5"
  promptVersion String /// "v1", "v2"… để so sánh chất lượng giữa các lần sửa prompt

  itemsInput   Int      @default(0)
  itemsOutput  Int      @default(0)
  flagged      Int      @default(0)
  tokensUsed   Int?
  durationMs   Int?
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([stage, createdAt])
  @@index([departmentId, year, week])
  @@map("ai_extraction_runs")
}

// ═══════════════════════════════════════════════════════════════════════════
// CRM đối tác — thay cho module Khách VIP (VipOrganization, VipGuestVisit).
//
// Theo dõi trọn một đối tác: cá nhân, tổ chức, chức vụ qua các thời kỳ, người
// thân/trợ lý, ngày quan trọng (dương hoặc âm lịch) và dòng thời gian tương tác
// — gồm tiếp đón, dẫn khách VIP khám bệnh, dẫn đoàn. Thiết kế: phác thảo CRM
// đã duyệt ngày 02/10/2026 (giai đoạn 1; nhắc nhở và quà tặng ở giai đoạn sau).
// ═══════════════════════════════════════════════════════════════════════════

enum CrmTier {
  VIP
  A
  B
  C
}

enum CrmOrganizationType {
  HOSPITAL // Bệnh viện, cơ sở y tế
  UNIVERSITY // Trường, viện nghiên cứu
  COMPANY // Doanh nghiệp
  GOVERNMENT // Cơ quan nhà nước
  INTERNATIONAL // Tổ chức quốc tế
  PRESS // Báo chí
  OTHER
}

enum CrmContactStatus {
  ACTIVE
  INACTIVE
}

enum CrmRelationKind {
  SPOUSE // Vợ/chồng
  CHILD // Con
  PARENT // Bố/mẹ
  ASSISTANT // Trợ lý
  SECRETARY // Thư ký riêng
  OTHER
}

enum CrmDateKind {
  BIRTHDAY // Sinh nhật
  APPOINTMENT // Ngày nhận chức
  FOUNDING // Ngày thành lập
  ANNIVERSARY // Ngày kỷ niệm khác (cưới, hợp tác…)
  OTHER
}

/// Lượt dẫn khách/đoàn thường được hẹn trước: ghi lịch hẹn, đến ngày đánh dấu đã xong.
enum CrmInteractionStatus {
  PLANNED // Lịch hẹn, chưa diễn ra
  DONE // Đã thực hiện
  POSTPONED // Hoãn / dời lịch chưa có ngày mới
  CANCELLED // Huỷ / khách không đến
}

enum CrmInteractionType {
  VIP_ESCORT // Dẫn khách VIP khám/chữa bệnh
  DELEGATION // Tiếp và dẫn đoàn
  MEETING // Gặp mặt, làm việc
  CALL // Gọi điện
  EMAIL // Email, thư
  EVENT // Mời/dự sự kiện
  GIFT // Tặng hoa, quà
  OTHER
}

model CrmOrganization {
  id             String              @id @default(cuid())
  name           String              @db.Text
  /// Tên đã chuẩn hoá (chữ thường, gọn khoảng trắng) — chống tạo trùng tổ chức.
  normalizedName String              @unique
  /// Tên viết thường, bỏ dấu, để tìm không dấu.
  searchKey      String              @default("")
  type           CrmOrganizationType @default(OTHER)
  tier           CrmTier             @default(C)
  address        String?             @db.Text
  website        String?
  phone          String?
  email          String?
  /// Nhân viên Phòng HC phụ trách quan hệ.
  ownerName      String?
  tags           String[]            @default([])
  note           String?             @db.Text
  isActive       Boolean             @default(true)
  /// Mã tổ chức trong sổ tiếp đoàn đã chuẩn hoá (vd TC-0088) — khoá nạp lại không tạo trùng.
  externalCode   String?             @unique
  /// Loại tổ chức chi tiết theo danh mục tiếp đoàn (Bệnh viện - Cơ sở y tế, Cơ quan quản lý nhà nước…).
  category       String?
  /// Phạm vi: Trong nước, Nước ngoài, Tổ chức quốc tế, Nội bộ ĐHYD TP.HCM.
  scope          String?
  /// Các cách viết tên khác đã gặp — tìm theo tên cũ vẫn ra.
  aliases        String[]            @default([])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  positions      CrmPosition[]
  importantDates CrmImportantDate[]
  interactions   CrmInteraction[]
  careTasks      CrmCareTask[]

  @@index([tier])
  @@map("crm_organizations")
}

model CrmContact {
  id            String           @id @default(cuid())
  fullName      String
  /// Họ tên + SĐT viết thường, bỏ dấu — tìm "nguyen van a" ra "Nguyễn Văn A".
  searchKey     String           @default("")
  /// Học hàm, học vị ghi trước tên: "PGS.TS.", "BS.CKII."
  academicTitle String?
  /// Cách xưng hô khi chúc mừng: "Thầy", "Chị", "Anh".
  salutation    String?
  gender        String?
  /// Ngày sinh tách phần: nhiều đối tác chỉ biết ngày/tháng, không biết năm.
  birthDay      Int?
  birthMonth    Int?
  birthYear     Int?
  birthIsLunar  Boolean          @default(false)
  phone         String?
  email         String?
  /// Địa chỉ nhận hoa, quà.
  giftAddress   String?          @db.Text
  tier          CrmTier          @default(C)
  tags          String[]         @default([])
  ownerName     String?
  /// Sở thích có cấu trúc: { flowers, avoid, food, hobbies } — dùng khi chọn quà.
  preferences   Json?
  /// Lưu ý nhạy cảm (sức khoẻ, gia đình): chỉ hiện cho người phụ trách và quản trị.
  sensitiveNote String?          @db.Text
  status        CrmContactStatus @default(ACTIVE)
  source        String?
  note          String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  positions      CrmPosition[]
  relationsFrom  CrmRelation[]               @relation("RelationFrom")
  relationsTo    CrmRelation[]               @relation("RelationTo")
  importantDates CrmImportantDate[]
  interactions   CrmInteraction[]
  participations CrmInteractionParticipant[]
  careTasks      CrmCareTask[]

  @@index([fullName])
  @@index([searchKey])
  @@index([tier])
  @@index([birthMonth, birthDay])
  @@map("crm_contacts")
}

/// Chức vụ qua các thời kỳ — người chuyển công tác vẫn giữ lịch sử.
model CrmPosition {
  id             String    @id @default(cuid())
  contactId      String
  organizationId String?
  title          String
  department     String?
  fromDate       DateTime?
  toDate         DateTime?
  isCurrent      Boolean   @default(true)
  /// Người này là đầu mối liên hệ của tổ chức (Phòng HC liên lạc qua người này).
  isFocalPoint   Boolean   @default(false)
  createdAt      DateTime  @default(now())

  contact      CrmContact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization CrmOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([organizationId])
  @@index([organizationId, isFocalPoint])
  @@map("crm_positions")
}

/// Người thân, trợ lý — để gửi lời chúc/quà đúng người. Người có hồ sơ riêng thì
/// nối toContactId; không thì chỉ ghi tên và số điện thoại.
model CrmRelation {
  id            String          @id @default(cuid())
  fromContactId String
  toContactId   String?
  name          String?
  phone         String?
  kind          CrmRelationKind
  note          String?         @db.Text
  createdAt     DateTime        @default(now())

  fromContact CrmContact  @relation("RelationFrom", fields: [fromContactId], references: [id], onDelete: Cascade)
  toContact   CrmContact? @relation("RelationTo", fields: [toContactId], references: [id], onDelete: SetNull)

  @@index([fromContactId])
  @@map("crm_relations")
}

/// Ngày quan trọng của một cá nhân HOẶC tổ chức; ngày âm lịch được đổi sang
/// dương lịch của từng năm khi tính ngày sắp tới (lib/crm/lunar.ts).
model CrmImportantDate {
  id               String      @id @default(cuid())
  contactId        String?
  organizationId   String?
  kind             CrmDateKind
  label            String?
  day              Int
  month            Int
  year             Int?
  isLunar          Boolean     @default(false)
  repeatsYearly    Boolean     @default(true)
  /// Nhắc trước bao nhiêu ngày; trống = theo hạng đối tác.
  remindDaysBefore Int?
  note             String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  contact      CrmContact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization CrmOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  careTasks    CrmCareTask[]

  @@index([contactId])
  @@index([organizationId])
  @@index([month, day])
  @@map("crm_important_dates")
}

/// Dòng thời gian quan hệ: mỗi lần tiếp đón, dẫn khám, dẫn đoàn, gặp mặt… một dòng.
model CrmInteraction {
  id                String               @id @default(cuid())
  type              CrmInteractionType
  status            CrmInteractionStatus @default(DONE)
  occurredAt        DateTime
  /// Khách chính (dẫn khám: khách VIP; dẫn đoàn: trưởng đoàn).
  contactId         String?
  organizationId    String?
  title             String?
  /// Nội dung hỗ trợ / làm việc.
  content           String               @db.Text
  /// Khoa/phòng hoặc nơi đến.
  destination       String?              @db.Text
  // ── Dẫn khách VIP khám bệnh ──
  /// Người được khám khi không phải chính khách (người nhà khách VIP).
  patientName       String?
  /// Dịch vụ đã hỗ trợ: Khám, Xét nghiệm, Chẩn đoán hình ảnh, Nội trú…
  services          String[]             @default([])
  // ── Dẫn đoàn ──
  guestCount        Int?
  /// Mục đích đoàn: Làm việc, Tham quan, Học tập, Ký kết…
  purpose           String?
  /// Nhân viên dẫn chính và người đi cùng.
  staffName         String
  companions        String[]             @default([])
  hospitalEventId   String?
  note              String?              @db.Text
  // ── Sổ tiếp đoàn ──
  /// Mã đoàn trong sổ tiếp đoàn (vd TD-2025-014) — khoá nạp lại không tạo trùng.
  externalCode      String?              @unique
  /// Ngày kết thúc với đoàn làm việc nhiều ngày.
  endAt             DateTime?
  /// Giờ tiếp như ghi nhận ("09g00-09g30") khi không quy được về một giờ.
  timeText          String?
  /// Nguồn không ghi ngày — occurredAt chỉ là ngày đầu năm để xếp chỗ.
  dateUnknown       Boolean              @default(false)
  /// Số văn bản đến (công văn xin làm việc).
  incomingDocNo     String?
  /// Khoa/phòng chủ trì tiếp đoàn.
  hostUnit          String?
  hostDepartmentId  String?
  /// Thành phần tiếp phía Bệnh viện và thành phần đoàn khách (danh sách người, ngăn bởi dấu ;).
  hospitalAttendees String?              @db.Text
  guestMembers      String?              @db.Text
  /// Chủ đề làm việc (CNTT - Chuyển đổi số, Quản lý chất lượng…).
  topics            String[]             @default([])
  /// Các đơn vị đi cùng đoàn.
  coOrganizations   String[]             @default([])
  /// Hình thức tiếp không có trong nguồn, suy ra từ nội dung.
  purposeInferred   Boolean              @default(false)
  giftsGiven        String?              @db.Text
  giftsReceived     String?              @db.Text
  /// Tiền mặt khách tặng, dự trù và thực chi quà (đồng).
  cashReceived      Int?
  giftBudget        Int?
  giftActualCost    Int?
  /// Dữ liệu gốc có điểm cần người phụ trách xác minh.
  needsReview       Boolean              @default(false)
  reviewNote        String?              @db.Text
  /// Nơi lấy dữ liệu (file | sheet | dòng).
  sourceRef         String?
  createdById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  contact        CrmContact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organization   CrmOrganization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  hostDepartment Department?                 @relation(fields: [hostDepartmentId], references: [id], onDelete: SetNull)
  participants   CrmInteractionParticipant[]
  photos         CrmPhoto[]
  careTask       CrmCareTask?

  @@index([occurredAt])
  @@index([status, occurredAt])
  @@index([type, occurredAt])
  @@index([contactId])
  @@index([organizationId])
  @@index([hostDepartmentId])
  @@map("crm_interactions")
}

/// Thành viên đoàn có hồ sơ — một lượt tiếp đoàn gắn vào hồ sơ của từng người.
model CrmInteractionParticipant {
  interactionId String
  contactId     String

  interaction CrmInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  contact     CrmContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([interactionId, contactId])
  @@index([contactId])
  @@map("crm_interaction_participants")
}

// ── Giai đoạn 2: chăm sóc đối tác — chuẩn bị quà, hoa cho các dịp ──────────

enum CrmGiftType {
  FLOWERS // Hoa
  GIFT // Quà
  CARD // Thiệp chúc mừng
  VISIT // Đến thăm, chúc mừng trực tiếp
  OTHER
}

enum CrmCareStatus {
  TODO // Chưa chuẩn bị
  ORDERED // Đã đặt hoa/quà
  DELIVERED // Đã trao
  CANCELLED // Không tặng nữa
}

/// Việc chuẩn bị quà/hoa cho MỘT lần diễn ra của một dịp (sinh nhật năm nay,
/// kỷ niệm thành lập năm nay…). Trao xong thì ghi thành lượt tương tác GIFT.
model CrmCareTask {
  id              String        @id @default(cuid())
  contactId       String?
  organizationId  String?
  /// Ngày quan trọng gốc; trống với sinh nhật (lấy từ hồ sơ) và dịp gõ tay.
  importantDateId String?
  occasionKind    CrmDateKind
  /// Ngày dương lịch của lần diễn ra (ngày âm đã đổi sang dương của năm đó).
  occasionDate    DateTime      @db.Date
  /// Khoá chống trùng: một việc cho mỗi (đối tác, dịp, ngày diễn ra) — xem lib/crm/care.ts.
  occasionKey     String        @unique
  giftType        CrmGiftType
  description     String        @db.Text
  /// Dự kiến và thực chi, đơn vị đồng.
  budget          Int?
  actualCost      Int?
  /// Nhân viên lo việc này (đặt, trao).
  assigneeName    String?
  status          CrmCareStatus @default(TODO)
  deliveredAt     DateTime?
  note            String?       @db.Text
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  /// Lượt tương tác GIFT tạo ra khi đánh dấu đã trao.
  interactionId   String?       @unique

  contact       CrmContact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization  CrmOrganization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Xoá ngày quan trọng không xoá lịch sử quà đã tặng.
  importantDate CrmImportantDate? @relation(fields: [importantDateId], references: [id], onDelete: SetNull)
  interaction   CrmInteraction?   @relation(fields: [interactionId], references: [id], onDelete: SetNull)

  photos CrmPhoto[]

  @@index([status, occasionDate])
  @@index([contactId])
  @@index([organizationId])
  @@map("crm_care_tasks")
}

/// Ảnh quà, hoa: quà đoàn khách tặng bệnh viện (gắn lượt tương tác) hoặc hoa,
/// quà phòng tặng đối tác (gắn việc chăm sóc). Lưu thẳng trong DB như hồ sơ xe.
enum CrmPhotoKind {
  RECEIVED // Quà, hoa bệnh viện nhận
  GIVEN // Quà, hoa tặng đối tác
  OTHER
}

model CrmPhoto {
  id            String       @id @default(cuid())
  interactionId String?
  careTaskId    String?
  kind          CrmPhotoKind @default(OTHER)
  caption       String?
  mimeType      String
  size          Int
  /// SHA-256 nội dung — chống tải trùng cùng một ảnh vào cùng một mục.
  sha256        String
  data          Bytes
  uploadedById  String?
  uploadedBy    String?
  createdAt     DateTime     @default(now())

  interaction CrmInteraction? @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  careTask    CrmCareTask?    @relation(fields: [careTaskId], references: [id], onDelete: Cascade)

  @@index([interactionId])
  @@index([careTaskId])
  @@map("crm_photos")
}

// ============================================
// QUẢN LÝ CÔNG VIỆC — theo dõi chỉ đạo của BGĐ và việc theo kế hoạch
// ============================================
// Nguồn chính là phân hệ Quản lý công việc của ứng dụng nội bộ: không có API,
// nên script cào chạy trong mạng UMC rồi đẩy file JSON lên (xem docs/WORK-MANAGEMENT.md).
// Phòng HC bổ sung tính chất, lưu ý để AI gợi ý các bước và đánh giá tiến độ.

enum WorkSource {
  QLCV // Cào từ phân hệ Quản lý công việc
  MANUAL // Phòng HC tự mở (việc theo kế hoạch)
}

enum WorkKind {
  DIRECTIVE // Chỉ đạo của Ban Giám đốc
  PLAN // Việc theo kế hoạch
  OTHER
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  DONE
  CANCELLED
}

enum WorkPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model WorkItem {
  id                String     @id @default(cuid())
  source            WorkSource @default(MANUAL)
  /// Mã công việc bên ứng dụng nội bộ; null với việc tự mở.
  externalId        String?
  externalUrl       String?
  kind              WorkKind   @default(DIRECTIVE)
  title             String     @db.Text
  description       String?    @db.Text
  /// Lãnh đạo chỉ đạo (vd "PGS.TS. Nguyễn Hoàng Bắc").
  directedBy        String?
  directedAt        DateTime?  @db.Date
  /// Đơn vị chủ trì như ghi ở nguồn, và phòng ban khớp được trong hệ thống.
  leadUnit          String?
  departmentId      String?
  coordinatingUnits String[]   @default([])
  assignees         String[]   @default([])
  /// Người theo dõi việc ở ứng dụng nội bộ (thường là chuyên viên đôn đốc).
  watchers          String[]   @default([])
  dueDate           DateTime?  @db.Date
  status            WorkStatus @default(NOT_STARTED)
  /// Trạng thái nguyên văn ở nguồn, giữ để đối chiếu cách quy đổi.
  externalStatus    String?
  progressPercent   Int?
  /// Ngày hoàn thành (ở nguồn hoặc lúc Phòng HC chuyển Hoàn thành) — tính đúng hạn, thời gian xử lý.
  completedAt       DateTime?
  /// Lần cập nhật gần nhất (ở nguồn hoặc ghi tay) — dùng để tìm việc lâu không cập nhật.
  lastActivityAt    DateTime?
  /// Lần cào gần nhất còn thấy việc này.
  lastSeenAt        DateTime?

  // ── B2: Phòng HC ghi nhận tính chất, lưu ý để AI gợi ý ──
  priority        WorkPriority @default(NORMAL)
  tags            String[]     @default([])
  /// Tính chất công việc: phạm vi, các bên liên quan, ràng buộc, nguồn lực…
  characteristics String?      @db.Text
  /// Lưu ý khi thực hiện.
  notes           String?      @db.Text
  /// Các bước AI gợi ý: [{ title, detail, dueDate?, done }].
  aiPlan          Json?
  /// Đánh giá tiến độ của AI: { level: on_track|at_risk|late, summary, nextAction }.
  aiAssessment    Json?
  aiUpdatedAt     DateTime?
  /// Lần gần nhất đã gửi email nhắc thư ký — không nhắc dồn dập.
  lastRemindedAt  DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  updates    WorkUpdate[]

  @@unique([source, externalId])
  @@index([status, lastActivityAt])
  @@index([departmentId])
  @@index([dueDate])
  @@index([completedAt])
  @@map("work_items")
}

/// Một lần cập nhật tiến độ: cào từ nguồn hoặc ghi tay.
model WorkUpdate {
  id              String     @id @default(cuid())
  workItemId      String
  source          WorkSource @default(MANUAL)
  occurredAt      DateTime
  author          String?
  content         String     @db.Text
  progressPercent Int?
  /// Hash (thời điểm + người + nội dung) — cào lại không tạo bản trùng.
  contentHash     String
  createdAt       DateTime   @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, contentHash])
  @@index([occurredAt])
  @@map("work_updates")
}

/// Mỗi lần nạp file cào: bao nhiêu việc mới, đổi, bao nhiêu cập nhật mới.
model WorkImportRun {
  id           String    @id @default(cuid())
  scrapedAt    DateTime?
  importedAt   DateTime  @default(now())
  triggeredBy  String?
  itemsSeen    Int       @default(0)
  itemsCreated Int       @default(0)
  itemsChanged Int       @default(0)
  updatesAdded Int       @default(0)
  /// Dòng bị bỏ qua và lý do.
  problems     Json?

  @@index([importedAt])
  @@map("work_import_runs")
}

// ============================================
// THEO DÕI NHIỆM VỤ — tình trạng từng việc cụ thể trong báo cáo tuần
// ============================================
// Mỗi phòng ghi báo cáo một kiểu: có phòng ghi 100% mọi tuần cho việc thường kỳ,
// có phòng ghi % tăng dần cho việc có tiến độ, có phòng không ghi % gì. Pipeline
// nối các dòng báo cáo qua các tuần thành "việc" (thread), rồi AI quyết định loại
// việc và tình trạng dựa trên cách báo cáo của phòng. Xem docs/TASK-TRACKING.md.

enum TaskThreadKind {
  ROUTINE // Thường kỳ — tuần nào cũng làm, không gán %
  PROJECT // Có tiến độ — theo dõi %
  ONE_OFF // Việc một lần
}

enum TaskThreadStatus {
  IN_PROGRESS
  DONE
  STALLED // Đứng yên nhiều tuần
  STOPPED // Ngừng báo cáo mà chưa xong
}

/// Cách báo cáo của một phòng, tính từ lịch sử — ngữ cảnh cho AI.
model DepartmentReportProfile {
  departmentId String   @id
  year         Int
  /// Số liệu thống kê: tỷ lệ dòng có %, ghi 100%, % thay đổi, % đứng yên…
  stats        Json
  /// Mô tả ngắn bằng lời đưa vào prompt.
  summary      String   @db.Text
  computedAt   DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("department_report_profiles")
}

/// Một việc cụ thể, theo dõi qua nhiều tuần báo cáo.
model TaskThread {
  id            String            @id @default(cuid())
  departmentId  String
  year          Int
  /// Tên nhiệm vụ như phòng ghi (cột B) và nhóm cha.
  rawName       String            @db.Text
  parentGroup   String?           @db.Text
  /// Tên ngắn của việc do AI đặt.
  title         String            @db.Text
  firstWeek     Int
  lastWeek      Int
  kind          TaskThreadKind?
  status        TaskThreadStatus?
  /// % hoàn thành (chỉ việc có tiến độ). Thường kỳ để trống.
  progress      Int?
  completedWeek Int?
  /// Căn cứ: câu trích trong báo cáo.
  evidence      String?           @db.Text
  reasoning     String?           @db.Text
  confidence    Float?
  /// AI chưa chắc — cần người xác nhận.
  needsReview   Boolean           @default(false)
  aiModel       String?
  aiUpdatedAt   DateTime?
  /// Tuần mới nhất của phòng lúc AI đánh giá — phòng có tuần mới thì việc vắng mặt cần đánh giá lại.
  judgedWeek    Int?
  /// Lần nối dòng mới gần nhất — AI phải đánh giá lại khi mốc này mới hơn aiUpdatedAt.
  changedAt     DateTime          @default(now())

  // Phòng HC sửa tay — AI không ghi đè.
  overrideKind     TaskThreadKind?
  overrideStatus   TaskThreadStatus?
  overrideProgress Int?
  overrideNote     String?           @db.Text
  overriddenBy     String?
  overriddenAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  entries    TaskThreadEntry[]

  @@index([departmentId, year, lastWeek])
  @@index([status])
  @@map("task_threads")
}

/// Một dòng báo cáo tuần (đúng dòng trong file gốc) thuộc về một việc.
model TaskThreadEntry {
  id           String   @id @default(cuid())
  threadId     String
  departmentId String
  year         Int
  week         Int
  sourceRow    Int
  rawName      String   @db.Text
  parentGroup  String?  @db.Text
  resultText   String   @db.Text
  progress     Int?
  timePeriod   String?
  nextWeekPlan String?  @db.Text
  createdAt    DateTime @default(now())

  thread TaskThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([departmentId, year, week, sourceRow])
  @@index([threadId, week])
  @@map("task_thread_entries")
}

enum TaskStreamMode {
  ROUTINE // Cả luồng (cùng tên nhiệm vụ) là một việc thường kỳ — nối mọi tuần vào một việc
  ITEMS // Luồng gồm nhiều việc cụ thể nối tiếp — giữ tách theo nội dung
}

/// Quyết định cho một "luồng" = các dòng cùng tên nhiệm vụ của một phòng trong năm.
model TaskStream {
  id           String         @id @default(cuid())
  departmentId String
  year         Int
  /// Tên nhiệm vụ đã bỏ dấu, viết thường.
  nameKey      String
  rawName      String         @db.Text
  mode         TaskStreamMode
  reasoning    String?        @db.Text
  /// "AI" hoặc tên người sửa.
  decidedBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([departmentId, year, nameKey])
  @@map("task_streams")
}

/// Báo cáo tóm tắt hoạt động Bệnh viện của một tuần — AI viết từ báo cáo các
/// phòng, Phòng HC sửa rồi chốt. Bản đã chốt làm mẫu văn phong cho lần sau.
model WeeklySummary {
  id          String    @id @default(cuid())
  weekId      String    @unique
  /// Nội dung theo cấu trúc lib/weekly-summary/types.ts (mục, đoạn, bảng, kế hoạch).
  content     Json
  /// DRAFT: AI vừa viết hoặc đang sửa; FINAL: Phòng HC đã chốt.
  status      String    @default("DRAFT")
  model       String?
  tokens      Int?
  generatedAt DateTime?
  editedAt    DateTime?
  editedBy    String?
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@map("weekly_summaries")
}

/// Kho tri thức cho chatbot: mọi đoạn văn tự do trong hệ thống (báo cáo tuần các
/// phòng, báo cáo tóm tắt, tiếp đoàn/CRM, công việc chỉ đạo, sự kiện) cắt thành
/// đoạn, có khoá tìm không dấu và vector ngữ nghĩa. Ghi bằng lib/chatbot/knowledge/indexer.ts.
model KnowledgeChunk {
  /// "<nguồn>:<id bản ghi>[:phần]"
  id             String                 @id
  source         String
  refId          String                 @map("ref_id")
  title          String
  body           String
  department     String?
  organization   String?
  occurredOn     DateTime?              @map("occurred_on") @db.Date
  year           Int?
  week           Int?
  href           String?
  /// Viết thường, bỏ dấu — tìm "nguyen phuoc loc" ra "Nguyễn Phước Lộc".
  searchKey      String                 @map("search_key")
  contentHash    String                 @map("content_hash")
  embedding      Unsupported("vector")?
  embeddingModel String?                @map("embedding_model")
  updatedAt      DateTime               @default(now()) @map("updated_at")

  @@index([source])
  @@index([occurredOn])
  @@map("knowledge_chunks")
}
