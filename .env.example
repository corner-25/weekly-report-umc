# Database
DATABASE_URL="postgresql://user:password@localhost:5432/report_db?schema=public"
# Read-only role for the AI chatbot (SELECT only, statement_timeout 5s)
DATABASE_URL_RO="postgresql://chatbot_readonly:CHANGE_ME@localhost:5432/report_db?schema=public"

# AI — zAI (Zhipu GLM) cho pipeline trích xuất báo cáo tuần bệnh viện
ZAI_API_KEY="..."

# AI Chatbot
DEEPSEEK_API_KEY="sk-..."
CHATBOT_MAX_TOKENS_PER_REQUEST="1500"
CHATBOT_RATE_LIMIT_PER_HOUR="20"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# File Upload
UPLOAD_DIR="./public/uploads"

# Dashboard Streamlit — mỗi cái là một service riêng trên Railway.
# Mã nguồn ở thư mục dashboards/. App chính chỉ link sang, không nhúng iframe.
DASHBOARD_TO_XE_URL="https://your-to-xe.railway.app"
DASHBOARD_PHONG_HC_OLD_URL="https://your-phong-hc-old.railway.app"

# Ingestion layer — đồng bộ dữ liệu tự động
CRON_SECRET="đổi-giá-trị-này-ở-production"
ONEDRIVE_DEPT_REPORT_SHARE_URL=""       # share link workbook báo cáo phòng
ONEDRIVE_HOSPITAL_REPORT_SHARE_URL=""   # share link workbook báo cáo bệnh viện
GOOGLE_SERVICE_ACCOUNT_JSON=""          # JSON service account (hoặc base64) cho Google Sheets đội xe
# Chatbot retention (cron calls POST /api/cron/chatbot-retention)
CHATBOT_AUDIT_RETENTION_DAYS="90"
CHATBOT_PROPOSAL_RETENTION_DAYS="30"
